<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <id>re.sonny.Retro</id>
  <launchable type="desktop-id">re.sonny.Retro.desktop</launchable>
  <name translatable="no">Retro</name>
  <developer id="sonny.re">
    <name translatable="no">Sonny Piers</name>
  </developer>
  <update_contact>sonnyp@gnome.org</update_contact>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0</project_license>
  <summary>Customizable clock widget</summary>
  <description>
    <p>Retro is a retro digital segment clock that can be customized. It can be used in the background, maximized or as an always on top widget.</p>
    <p>Supported features:</p>
    <ul>
      <li>24h/12h format</li>
      <li>styling with CSS</li>
      <li>restore window size</li>
      <li>maximized, fullscreen and tiling</li>
    </ul>
  </description>
  <url type="homepage">https://retro.sonny.re</url>
  <url type="bugtracker">https://retro.sonny.re/feedback</url>
  <url type="donation">https://retro.sonny.re/donate</url>
  <url type="vcs-browser">https://retro.sonny.re/source</url>

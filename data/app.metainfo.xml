  <content_rating type="oars-1.1" />
  <releases>
    <release version="2.2" date="2025-10-13">
      <description translatable="no">
        <ul>
          <li>Use GNOME Platform 49</li>
        </ul>
      </description>
    </release>
    <release version="2.1" date="2025-02-14">
      <description translatable="no">
        <ul>
          <li>Update application icon</li>
          <li>Add fullscreen option</li>
          <li>Disable rounded corners when the window is tiled</li>
          <li>Hide header bar when the window is tiled</li>
          <li>Use GNOME 47</li>
        </ul>
      </description>
    </release>
    <release version="2.0" date="2024-04-14">
      <description translatable="no">
        <ul>
          <li>Move the menu button outside the clock</li>
          <li>Support 12h / AM-PM clock format</li>
          <li>Optimize energy usage</li>
          <li>Remember window size</li>
          <li>Add close button</li>
          <li>Add drag handle</li>
          <li>Disable rounded corner when maximize or fullscreen</li>
          <li>Solved a crash</li>
          <li>Use GNOME 46</li>
          <li>Set a window title</li>
        </ul>
      </description>
    </release>
    <release version="1.0" date="2022-10-19">
      <description translatable="no"><p>This is the first release of Retro. Enjoy.</p></description>
    </release>
  </releases>

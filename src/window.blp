using Gtk 4.0;
using Adw 1;

template $RetroWindow : Adw.ApplicationWindow {
  name: "window";
  title: "Retro";
  content: Gtk.WindowHandle {
    Overlay {
      [overlay]
      Gtk.CenterBox overlay_controls {
        valign: start;
        opacity: 0;

        [start]
        MenuButton {
          name: "button-menu";
          icon-name: "open-menu-symbolic";
          menu-model: primary_menu;
          primary: true;
          styles ["circular", "osd"]
        }

        [end]
        Gtk.Button button_close {
          name: "button-close";
          icon-name: "window-close-symbolic";
          styles ["circular", "osd"]
        }
      }

      Gtk.Box content {
        halign: center;
        valign: center;
        Overlay {
          [overlay]
          Label foreground {
            name: "foreground";
            label: "!!!!!!!!";
          }

          Label background {
            name: "background";
            label: "88:88:88";
          }
        }
      }
    }
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Display seconds");
      action: "win.display-seconds";
    }

    item {
      label: _("_Customize");
      action: "win.customize";
    }
  }

  section {
    item {
      label: _("_About Retro");
      action: "app.about";
    }
  }
}

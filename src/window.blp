using Gtk 4.0;
using Adw 1;
using Gdk 4.0;

template $RetroWindow : Adw.ApplicationWindow {
  name: "container";
  title: "Retro";

  WindowHandle {
    Box {
      orientation: vertical;
      Box header {
        name: "toolbar";
        halign: end;
        styles ["toolbar", "osd"]

        Button {
          sensitive: false;
          icon-name: "list-drag-handle-symbolic";
          cursor: Gdk.Cursor {
            name: "move";
          };
        }

        MenuButton {
          name: "button-menu";
          icon-name: "open-menu-symbolic";
          menu-model: primary_menu;
          primary: true;
          tooltip-text: _("Main Menu");
        }

        Gtk.WindowControls window_controls {
          decoration-layout: "close";
        }
      }

      Box window {
        name: "window";

        Gtk.Box {
          halign: center;
          valign: center;
          vexpand: true;
          hexpand: true;

          Overlay {
            [overlay]
            Label foreground {
              name: "foreground";
              label: "!!!!!!!!";
            }

            Label background {
              name: "background";
              label: "88:88:88";
            }
          }
        }
      }
    }
  }
}

menu primary_menu {
  section {
    item {
      label: _("_Display seconds");
      action: "win.display-seconds";
    }

    item {
      label: _("_Customize");
      action: "win.customize";
    }

    item {
      label: _("_Fullscreen");
      action: "win.fullscreen";
    }
  }

  section {
    item {
      label: _("_About Retro");
      action: "app.about";
    }
  }
}
